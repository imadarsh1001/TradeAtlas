# Open Government Data (OGD) Platform India API Key
# Register at https://data.gov.in to get your personal key
DATA_GOV_IN_API_KEY=your_api_key_here

# Agent live benchmark (docs/BENCHMARK_METHODOLOGY.md) — replay tests need none of these.
# The agent resolves TRADEATLAS_AGENT_MODEL through the model registry
# (tradeatlas/agent/model_registry.py: key or raw model id, enabled entries only)
# and routes ALL live LLM traffic through Cloudflare AI Gateway.
TRADEATLAS_AGENT_MODEL=your_model_key_or_id_here

# Cloudflare AI Gateway (required for any live agent/eval run)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_GATEWAY_ID=your_gateway_id
CF_AIG_TOKEN=your_ai_gateway_token

# Provider keys — only needed by NON-BYOK registry entries (BYOK entries use
# keys stored in the Cloudflare dashboard; no client-side key is sent)
NVIDIA_API_KEY=your_key_here
CF_WAI_TOKEN=your_workers_ai_token_here
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=global

# Live-suite pacing: inter-case delay seconds (default 45; runner also honors
# each entry's rpm_limit). OPENAI_API_KEY/OPENAI_BASE_URL are NOT used by the
# agent path anymore (the gateway replaces direct provider endpoints).
TRADEATLAS_INTER_CASE_DELAY=45
